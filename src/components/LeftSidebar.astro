---
import { getCollection } from 'astro:content';

interface Props { currentSlug: string; mode: 'knowledges' | 'books'; }
const { currentSlug, mode } = Astro.props;

if (mode === 'knowledges') {
  var items = await getCollection('knowledges');
  var categories: Record<string, typeof items> = {};
  items.forEach(item => {
    const cat = item.data.category || '未分类';
    if (!categories[cat]) categories[cat] = [];
    categories[cat].push(item);
  });
} else {
  var items = await getCollection('books');
  var categories: Record<string, typeof items> = {};
  items.forEach(item => {
    const cat = item.data.category || '读书记录';
    if (!categories[cat]) categories[cat] = [];
    categories[cat].push(item);
  });
}
---
<aside class="left-sidebar" id="leftSidebar">
  <button class="collapse-btn" id="collapseBtn" aria-label="收起目录">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M10 4L6 8L10 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="sidebar-content">
    <div class="sb-title">{mode === 'knowledges' ? '知识笔记' : '读书记录'}</div>
    {Object.entries(categories).map(([cat, catItems]) => (
      <div class="sb-group">{cat}</div>
      <ul>
        {catItems.map(item => (
          <li><a href={`/${mode}/${item.id}`}
                 class:list={[{ active: item.id === currentSlug }]}>
            {item.data.title}
          </a></li>
        ))}
      </ul>
    ))}
  </div>
</aside>

<script>
  const collapseBtn = document.getElementById('collapseBtn');
  const sidebar = document.getElementById('leftSidebar');

  collapseBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('collapsed');
    const isCollapsed = sidebar?.classList.contains('collapsed');
    collapseBtn.setAttribute('aria-label', isCollapsed ? '展开目录' : '收起目录');
  });
</script>

<style>
  .left-sidebar {
    position: relative;
    border-right: 1px solid var(--line);
    overflow: hidden;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    transition: width 0.3s ease;
    width: 220px;
  }
  .left-sidebar.collapsed {
    width: 0;
    border-right: none;
  }
  .left-sidebar.collapsed .sidebar-content {
    opacity: 0;
    pointer-events: none;
  }

  .collapse-btn {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: var(--paper);
    border: 1px solid var(--line);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: all .2s;
    z-index: 10;
  }
  .collapse-btn:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .left-sidebar.collapsed .collapse-btn {
    right: -32px;
  }

  .sidebar-content {
    padding: 20px 0 20px 20px;
    opacity: 1;
    transition: opacity 0.2s;
  }

  .sb-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .sb-group {
    font-weight: 700;
    color: var(--ink);
    padding: 5px 10px;
    font-size: 12px;
    margin-top: 8px;
  }
  ul { list-style: none; padding-left: 0; }
  li { margin: 1px 0; }
  a {
    display: block;
    padding: 5px 10px;
    border-radius: 5px;
    color: var(--muted);
    transition: all .15s;
    text-decoration: none;
  }
  a:hover { color: var(--ink); background: rgba(176, 58, 46, .05); }
  a.active { color: var(--accent); background: rgba(176, 58, 46, .08); font-weight: 600; }
</style>
