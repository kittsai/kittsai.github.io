---
import { getCollection } from 'astro:content';

interface Props { currentSlug: string; mode: 'knowledges' | 'books'; }
const { currentSlug, mode } = Astro.props;

if (mode === 'knowledges') {
  var items = await getCollection('knowledges');
  var categories: Record<string, typeof items> = {};
  items.forEach(item => {
    const cat = item.data.category || '未分类';
    if (!categories[cat]) categories[cat] = [];
    categories[cat].push(item);
  });
} else {
  var items = await getCollection('books');
  var categories: Record<string, typeof items> = {};
  items.forEach(item => {
    const cat = item.data.category || '读书记录';
    if (!categories[cat]) categories[cat] = [];
    categories[cat].push(item);
  });
}
---
<aside class="left-sidebar">
  <div class="sb-title">{mode === 'knowledges' ? '知识笔记' : '读书记录'}</div>
  {Object.entries(categories).map(([cat, catItems]) => (
    <details class="sb-category" open>
      <summary class="sb-group">{cat}</summary>
      <ul>
        {catItems.map(item => (
          <li><a href={`/${mode}/${item.id}`}
                 class:list={[{ active: item.id === currentSlug }]}>
            {item.data.title}
          </a></li>
        ))}
      </ul>
    </details>
  ))}
</aside>

<style>
  .left-sidebar {
    border-right: 1px solid var(--line);
    padding: 20px 0 20px 20px;
    overflow-y: auto;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
  }
  .sb-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--muted);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .sb-category {
    margin-top: 8px;
  }
  .sb-group {
    font-weight: 700;
    color: var(--ink);
    padding: 5px 10px;
    font-size: 12px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sb-group::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 4px solid var(--muted);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.2s;
  }
  .sb-category[open] > .sb-group::before {
    transform: rotate(90deg);
  }
  .sb-group::-webkit-details-marker {
    display: none;
  }
  ul { list-style: none; padding-left: 0; }
  li { margin: 1px 0; }
  a {
    display: block;
    padding: 5px 10px;
    border-radius: 5px;
    color: var(--muted);
    transition: all .15s;
    text-decoration: none;
  }
  a:hover { color: var(--ink); background: rgba(176, 58, 46, .05); }
  a.active { color: var(--accent); background: rgba(176, 58, 46, .08); font-weight: 600; }
</style>
