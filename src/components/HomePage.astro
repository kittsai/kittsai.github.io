---
import { getCollection } from 'astro:content';

const notes = await getCollection('knowledges');
const books = await getCollection('books');

const categories: Record<string, typeof notes> = {};
notes.forEach(note => {
  const cat = note.data.category || '未分类';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(note);
});

const totalArticles = notes.length;
const totalCategories = Object.keys(categories).length;
const totalBooks = books.length;
---
<div class="home-page">
  <div class="hero">
    <h1>kit-docs</h1>
    <p class="tagline">记录学习，沉淀知识 — Java & 中间件技术笔记</p>
    <div class="actions">
      <a class="btn btn-primary" href="/knowledges/">📖 开始阅读</a>
      <a class="btn btn-outline" href="https://github.com/kittsai/kittsai.github.io">⭐ GitHub</a>
    </div>
  </div>

  <div class="stats">
    <div><div class="stat-num">{totalArticles}</div><div class="stat-label">篇文章</div></div>
    <div><div class="stat-num">{totalCategories}</div><div class="stat-label">个分类</div></div>
    <div><div class="stat-num">{totalBooks}</div><div class="stat-label">本书</div></div>
  </div>

  <h2 class="section-title">📝 知识笔记</h2>
  <div class="cards-grid">
    {Object.entries(categories).map(([cat, items]) => (
      <div class="card">
        <div class="card-header">
          <span class="card-icon">{cat === 'Java' ? '☕' : '🔧'}</span>
          <span class="card-title">{cat}</span>
          <span class="card-count">{items.length} 篇</span>
        </div>
        <div class="card-links">
          {items.map(item => (
            <a href={`/knowledges/${item.id}`}>{item.data.title}</a>
          ))}
        </div>
      </div>
    ))}
  </div>

  {totalBooks > 0 && (
    <>
      <h2 class="section-title">📚 读书记录</h2>
      <div class="cards-grid">
        {books.map(book => (
          <div class="card">
            <div class="card-header">
              <span class="card-icon">📖</span>
              <span class="card-title">{book.data.title}</span>
            </div>
          </div>
        ))}
      </div>
    </>
  )}
</div>

<style>
  .home-page { max-width: 1100px; margin: 0 auto; padding: 0 30px; }

  .hero { text-align: center; padding: 64px 0 48px; border-bottom: 3px double var(--ink); margin-bottom: 40px; }
  .hero h1 { font-size: clamp(36px, 5vw, 54px); font-weight: 800; letter-spacing: -.02em; margin-bottom: 8px; }
  .tagline { color: var(--muted); font-size: 16px; max-width: 520px; margin: 0 auto 24px; }
  .actions { display: flex; gap: 12px; justify-content: center; }

  .btn {
    padding: 10px 28px;
    border-radius: 8px;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
    text-decoration: none;
  }
  .btn-primary { background: var(--accent); color: #fff; border: none; }
  .btn-primary:hover { opacity: .85; text-decoration: none; }
  .btn-outline { background: transparent; border: 1px solid var(--line); color: var(--ink); }
  .btn-outline:hover { border-color: var(--ink); text-decoration: none; }

  .stats { display: flex; justify-content: center; gap: 56px; padding: 32px 0; border-bottom: 1px solid var(--line); margin-bottom: 40px; }
  .stat-num { font-size: 28px; font-weight: 800; color: var(--accent); }
  .stat-label { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 12px; color: var(--muted); margin-top: 2px; }

  .section-title {
    font-family: "Helvetica Neue", Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: .22em;
    font-size: 13px;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
    margin: 36px 0 20px;
  }

  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 4px 16px rgba(40, 30, 15, .04);
    transition: box-shadow .2s, transform .2s;
  }
  .card:hover { box-shadow: 0 8px 24px rgba(40, 30, 15, .08); transform: translateY(-2px); }
  .card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .card-icon { font-size: 22px; }
  .card-title { font-size: 16px; font-weight: 700; }
  .card-count {
    margin-left: auto;
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
    color: var(--muted);
    background: var(--bg);
    padding: 2px 8px;
    border-radius: 10px;
  }
  .card-links { display: flex; flex-direction: column; gap: 4px; }
  .card-links a {
    font-size: 13px;
    color: var(--ink);
    padding: 5px 8px;
    border-radius: 4px;
    transition: background .15s;
    text-decoration: none;
  }
  .card-links a:hover { background: var(--bg); color: var(--accent); text-decoration: none; }
</style>
