---
import { site } from '../../config/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const isActive = (href: string) => {
  if (href === '/#latest-notes') {
    return pathname === '/' || pathname === '/knowledge' || pathname.startsWith('/knowledges/');
  }
  return pathname === href || pathname.startsWith(`${href}/`);
};
---
<a class="brand" href="/" aria-label="Kittsai 首页">Kittsai</a>
<nav aria-label="主导航">
  {site.navigation.map((item) => (
    <a class:list={{ active: isActive(item.href) }} href={item.href}>{item.label}</a>
  ))}
</nav>

<style>
  .brand {
    justify-self: start;
    display: block;
    color: var(--color-text);
    font: 400 24px/1 var(--font-display);
    letter-spacing: -.025em;
    text-decoration: none;
  }
  nav { display: flex; gap: 30px; }
  nav a {
    position: relative;
    color: var(--color-muted);
    font: 500 12px var(--font-mono);
    letter-spacing: .08em;
    text-decoration: none;
  }
  nav a:hover,
  nav a.active { color: var(--color-text); }
  nav a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -27px;
    height: 2px;
    background: var(--color-accent-strong);
  }
  @media (max-width: 820px) {
    .brand { font-size: 21px; }
    nav { display: flex; gap: 18px; }
    nav a { font-size: 11px; }
    nav a.active::after { bottom: -28px; }
  }
</style>
