---
import BrandNavigation from '../site/BrandNavigation.astro';
const pathname = Astro.url.pathname;
---
<div class="knowledge-header">
  <BrandNavigation pathname={pathname} />
</div>
<style>
  .knowledge-header {
    width: min(var(--shell), calc(100vw - 48px));
    height: 100%;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  @media (max-width: 820px) {
    .knowledge-header {
      width: min(var(--shell), calc(100vw - 30px));
      grid-template-columns: 1fr auto;
    }
  }
</style>
