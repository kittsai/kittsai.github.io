---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const books = await getCollection('books');
---

<BaseLayout title="读书记录">
  <main style="max-width:800px;margin:60px auto;padding:0 24px;">
    <h1 style="font-size:32px;margin-bottom:24px;">读书记录</h1>
    <ul style="list-style:none;padding:0;">
      {books.map(book => (
        <li style="margin-bottom:8px;">
          <a href={`/books/${book.id}`} style="font-size:16px;color:var(--ink);text-decoration:none;padding:8px 12px;display:block;border-radius:6px;transition:background .15s;">
            {book.data.title}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
