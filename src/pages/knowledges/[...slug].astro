---
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import DetailLayout from '../../layouts/DetailLayout.astro';
import LeftSidebar from '../../components/LeftSidebar.astro';
import TabBar from '../../components/TabBar.tsx';
import RightTOC from '../../components/RightTOC.astro';

export async function getStaticPaths() {
  const notes = await getCollection('knowledges');
  return notes.map(note => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

let aiSummaryHtml = '';
try {
  const summaryPath = join(process.cwd(), 'summaries', `${note.id}.html`);
  aiSummaryHtml = readFileSync(summaryPath, 'utf-8');
} catch {
  aiSummaryHtml = '<div class="no-summary">暂无 AI 摘要，请先生成。</div>';
}
---

<DetailLayout title={note.data.title}>
  <LeftSidebar slot="sidebar" currentSlug={note.id} mode="knowledges" />

  <div slot="main" class="main-content">
    <div class="mobile-toc-bar" id="mobileTocBar">
      <button class="toc-toggle" id="sidebarToggle">📑 目录</button>
      <button class="toc-toggle" id="rightTocToggle">📑 本页目录</button>
    </div>

    <TabBar client:load />

    <div class="tab-panel active tab-original" id="tab-original">
      <div class="markdown-body">
        <Content />
      </div>
      <RightTOC headings={headings} />
    </div>

    <div class="tab-panel tab-ai" id="tab-ai">
      <div class="ai-embed" set:html={aiSummaryHtml} />
    </div>

    <div class="mobile-overlay" id="mobileOverlay"></div>
  </div>
</DetailLayout>

<script>
  const sidebar = document.getElementById('leftSidebar');
  const rightToc = document.querySelector('.right-toc');
  const overlay = document.getElementById('mobileOverlay');
  const sidebarBtn = document.getElementById('sidebarToggle');
  const rightTocBtn = document.getElementById('rightTocToggle');

  function closeAll() {
    sidebar?.classList.remove('mobile-open');
    rightToc?.classList.remove('mobile-open');
    overlay?.classList.remove('active');
  }

  sidebarBtn?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.toggle('mobile-open');
    overlay?.classList.toggle('active', isOpen);
    rightToc?.classList.remove('mobile-open');
  });

  rightTocBtn?.addEventListener('click', () => {
    const isOpen = rightToc?.classList.toggle('mobile-open');
    overlay?.classList.toggle('active', isOpen);
    sidebar?.classList.remove('mobile-open');
  });

  overlay?.addEventListener('click', closeAll);

  // 点击链接后自动关闭侧边栏
  sidebar?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeAll));
  rightToc?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeAll));
</script>

<style>
  .main-content { overflow: hidden; height: 100%; }

  .tab-panel { display: none; border: 1px solid var(--line); border-top: none; border-radius: 0 0 10px 10px; overflow: hidden; }
  .tab-panel.active { display: block; }
  .tab-panel.active.tab-original {
    display: grid;
    grid-template-columns: 1fr 200px;
    height: calc(100vh - 100px);
  }
  .tab-panel.active.tab-ai { height: calc(100vh - 100px); }

  .markdown-body { padding: 28px 32px; background: var(--paper); overflow-y: auto; overflow-x: hidden; height: 100%; min-width: 0; }
  .markdown-body :global(h2) { font-size: 22px; margin: 28px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .markdown-body :global(h3) { font-size: 18px; margin: 22px 0 8px; }
  .markdown-body :global(h4) { font-size: 15px; margin: 18px 0 6px; }
  .markdown-body :global(p) { margin: 8px 0; font-size: 14px; }
  .markdown-body :global(ul), .markdown-body :global(ol) { padding-left: 22px; margin: 6px 0; }
  .markdown-body :global(li) { margin: 4px 0; font-size: 14px; }
  .markdown-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 8px 16px;
    margin: 12px 0;
    background: rgba(176, 58, 46, .04);
    border-radius: 0 6px 6px 0;
    font-size: 14px;
    color: var(--muted);
  }
  .markdown-body :global(table) { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; display: block; overflow-x: auto; }
  .markdown-body :global(th), .markdown-body :global(td) { border: 1px solid var(--line); padding: 6px 10px; text-align: left; white-space: nowrap; }
  .markdown-body :global(th) { background: #efe7d8; font-weight: 700; }
  .markdown-body :global(pre) { max-width: 100%; overflow-x: auto; }
  .markdown-body :global(img) { max-width: 100%; height: auto; }
  .markdown-body :global(table) { table-layout: fixed; word-break: break-word; }

  .ai-embed { overflow-y: auto; height: 100%; background: var(--bg); }
  .ai-embed :global(.wrap) { max-width: 1100px; margin: 0 auto; padding: 24px 24px 60px; }

  .no-summary { padding: 40px; text-align: center; color: var(--muted); font-family: "Helvetica Neue", Arial, sans-serif; }

  /* Mobile TOC bar - hidden on desktop */
  .mobile-toc-bar { display: none; }

  @media (max-width: 768px) {
    .mobile-toc-bar {
      display: flex;
      gap: 8px;
      padding: 8px 16px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 52px;
      z-index: 90;
    }
    .toc-toggle {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--bg);
      color: var(--ink);
      font-size: 13px;
      font-family: "Helvetica Neue", Arial, sans-serif;
      cursor: pointer;
      transition: background .15s;
    }
    .toc-toggle:hover { background: var(--line); }
    .toc-toggle:active { background: var(--accent); color: #fff; }

    .tab-panel.active.tab-original {
      grid-template-columns: 1fr;
      height: calc(100vh - 52px - 41px);
    }
    .tab-panel.active.tab-ai { height: calc(100vh - 52px - 41px); }
    .markdown-body { padding: 16px; }
  }
</style>
