---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = await getCollection('knowledges');

const categories: Record<string, typeof notes> = {};
notes.forEach(note => {
  const cat = note.data.category || '未分类';
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(note);
});
---

<BaseLayout title="知识笔记">
  <main style="max-width:800px;margin:60px auto;padding:0 24px;">
    <h1 style="font-size:32px;margin-bottom:24px;">知识笔记</h1>
    {Object.entries(categories).map(([cat, items]) => (
      <div style="margin-bottom:32px;">
        <h2 style="font-size:20px;margin-bottom:12px;color:var(--accent);">{cat}</h2>
        <ul style="list-style:none;padding:0;">
          {items.map(item => (
            <li style="margin-bottom:8px;">
              <a href={`/knowledges/${item.id}`} style="font-size:16px;color:var(--ink);text-decoration:none;padding:8px 12px;display:block;border-radius:6px;transition:background .15s;">
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </main>
</BaseLayout>
