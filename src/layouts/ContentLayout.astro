---
import BaseLayout from './BaseLayout.astro';
interface Props { title:string; description:string; eyebrow?:string; meta?:string; }
const { title, description, eyebrow='Blog', meta } = Astro.props;
---
<BaseLayout title={`${title} — Kittsai`} description={description} class="light-page">
  <article class="editorial">
    <header class="article-header">
      <div class="article-kicker"><span>{eyebrow}</span><i></i><span>Kit's field notes</span></div>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      {meta && <p class="meta">{meta}</p>}
    </header>
    <div class="article-rule"></div>
    <div class="prose"><slot /></div>
    <footer class="article-end">
      <span class="author-mark">K</span>
      <div><b>Written by Kittsai</b><p>记录构建、学习与理解系统的过程。</p></div>
      <a href="/writing">全部博客 ↗</a>
    </footer>
  </article>
</BaseLayout>
<style>
  .editorial{width:min(100% - 48px,980px);margin-inline:auto;padding:7rem 0 8rem}.article-header{max-width:820px;margin-inline:auto;text-align:center}.article-kicker{display:flex;justify-content:center;align-items:center;gap:.7rem;color:var(--color-accent-strong);font:500 10px/1.4 var(--font-mono);letter-spacing:.13em;text-transform:uppercase}.article-kicker i{width:3px;height:3px;background:currentColor;border-radius:50%}.article-header h1{margin:1.5rem auto 1.4rem;font-family:var(--font-reading);font-size:clamp(3.4rem,7vw,6.6rem);font-weight:600;line-height:1.02;letter-spacing:-.055em;text-wrap:balance}.dek{max-width:690px;margin:0 auto;color:var(--color-muted);font:1.12rem/1.75 var(--font-sans);text-wrap:balance}.meta{margin:1.8rem 0 0;color:var(--color-soft);font:10px var(--font-mono);text-transform:uppercase;letter-spacing:.1em}.article-rule{height:1px;max-width:820px;margin:4.5rem auto;background:var(--color-border)}.editorial :global(.prose){margin-inline:auto}.article-end{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;max-width:700px;margin:6rem auto 0;padding-top:2rem;border-top:1px solid var(--color-border)}.author-mark{display:grid;width:44px;height:44px;place-items:center;color:#080a07;background:var(--color-accent);border-radius:50%;font:600 14px var(--font-mono)}.article-end b{font-size:.86rem}.article-end p{margin:.2rem 0 0;color:var(--color-muted);font-size:.75rem}.article-end a{color:var(--color-muted);font-size:.75rem}.article-end a:hover{color:var(--color-accent-strong)}@media(max-width:760px){.editorial{width:min(100% - 30px,980px);padding:4.5rem 0 5.5rem}.article-header{text-align:left}.article-kicker{justify-content:flex-start}.article-header h1{font-size:clamp(3rem,14vw,4.5rem);text-wrap:wrap}.dek{text-wrap:wrap}.article-rule{margin:3.2rem auto}.article-end{grid-template-columns:auto 1fr}.article-end>a{display:none}}
  /* Keep long-form writing closer to an editorial page than a landing-page hero. */
  .article-header{max-width:740px;text-align:left}
  .article-kicker{justify-content:flex-start}
  .article-header h1{margin:1.5rem 0 1.35rem;font-family:var(--font-display);font-size:clamp(3.4rem,6vw,5.2rem);font-weight:400;line-height:1.02;letter-spacing:-.035em}
  .dek{max-width:700px;margin:0;font-size:1.18rem;line-height:1.68}
  .meta{margin-top:1.7rem}
  .article-rule{max-width:740px;margin:4rem auto}
</style>
